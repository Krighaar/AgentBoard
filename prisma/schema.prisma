generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  criteria    String    @default("")
  repoUrl     String    @default("")
  status      String    @default("todo") // todo | ready | in_progress | done | failed
  priority    Int       @default(2) // 1=high, 2=medium, 3=low
  agentPid    Int?
  startedAt   DateTime?
  completedAt DateTime?
  retryCount  Int       @default(0)
  maxRetries  Int       @default(2)
  error       String?
  position    Int       @default(0)
  summary     String?   // AI-generated summary of agent output
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costEstimate Float    @default(0) // estimated cost in USD
  tags        String    @default("") // comma-separated tags
  dependsOn   String    @default("") // JSON array of task IDs
  model       String    @default("") // claude model override (e.g. "sonnet", "haiku", "opus")
  boardId     String    @default("default")
  // Scheduling fields
  scheduledFor   DateTime?          // one-time schedule
  cronExpression String   @default("") // recurring cron (e.g., "0 9 * * 1")
  recurring      Boolean  @default(false) // marks template tasks
  sourceTaskId   String   @default("") // links cloned tasks to template
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  board Board  @relation(fields: [boardId], references: [id])
  logs  TaskLog[]

  @@index([boardId])
}

model Board {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks    Task[]
  memories Memory[]
}

model Setting {
  key   String @id
  value String
}

model TaskLog {
  id        String   @id @default(cuid())
  taskId    String
  stream    String   @default("stdout") // stdout | stderr | system
  content   String
  timestamp DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, timestamp])
}

model Memory {
  id           String   @id @default(cuid())
  boardId      String
  key          String
  value        String
  source       String   @default("manual") // manual | agent
  sourceTaskId String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  board Board @relation(fields: [boardId], references: [id])

  @@unique([boardId, key])
  @@index([boardId])
}

model Skill {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  prompt      String   @default("")
  criteria    String   @default("")
  model       String   @default("")
  tags        String   @default("")
  isBuiltIn   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Integration {
  id        String   @id @default(cuid())
  type      String          // "slack" | "webhook"
  name      String
  config    String   @default("{}") // JSON blob
  enabled   Boolean  @default(true)
  events    String   @default("task:done,task:failed") // events to fire on
  boardId   String   @default("") // scope to board, or "" for all
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
