generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  criteria    String    @default("")
  repoUrl     String    @default("")
  status      String    @default("todo") // todo | ready | in_progress | done | failed
  priority    Int       @default(2) // 1=high, 2=medium, 3=low
  agentPid    Int?
  startedAt   DateTime?
  completedAt DateTime?
  retryCount  Int       @default(0)
  maxRetries  Int       @default(2)
  error       String?
  position    Int       @default(0)
  summary     String?   // AI-generated summary of agent output
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costEstimate Float    @default(0) // estimated cost in USD
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  logs TaskLog[]
}

model Setting {
  key   String @id
  value String
}

model TaskLog {
  id        String   @id @default(cuid())
  taskId    String
  stream    String   @default("stdout") // stdout | stderr | system
  content   String
  timestamp DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId, timestamp])
}
